GEMINI_API_KEY=
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<options>
MONGODB_DATABASE=ai_resume_analyzer
AUTH_SECRET=replace-with-a-long-random-secret
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=5242880
MAX_RESUME_TEXT_CHARS=200000
AUTH_RATE_LIMIT=20
ANALYSIS_RATE_LIMIT=12
# Optional OAuth integration (not enabled until these and a production redirect URI are configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/auth/google/callback
